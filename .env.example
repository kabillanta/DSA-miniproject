# ==============================================================================
# Real-Time Server Health Monitoring and Anomaly Detection - Configuration
# ==============================================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=server-metrics
KAFKA_CONSUMER_GROUP=server-health-processor-group

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=server_health_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_TYPE=postgresql
SQLITE_DB_PATH=server_health.db

# Synthetic Data Producer Settings
PRODUCER_INTERVAL_SECONDS=1.0
ANOMALY_PROBABILITY=0.08
SERVER_IDS=server-01,server-02,server-03

# Stream Processor Settings
SLIDING_WINDOW_SIZE=30

# Machine Learning Settings
MODEL_PATH=models/isolation_forest.joblib
MODEL_METADATA_PATH=models/model_metadata.json
CONTAMINATION=0.05
N_ESTIMATORS=100
RANDOM_STATE=42

# Dashboard Settings
DASHBOARD_REFRESH_INTERVAL=2
DASHBOARD_HISTORY_LIMIT=100

